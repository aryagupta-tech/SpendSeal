PORT=43117
HOST=127.0.0.1
# For `npm run dev`, browser routes are served by Vite and API/MCP calls proxy to port 43117.
PUBLIC_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql://agentrail:agentrail-local-only@127.0.0.1:5432/agentrail
# Generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
CREDENTIAL_ENCRYPTION_KEY_VERSION=1
OAUTH_ISSUER=http://localhost:5173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_RP_NAME=SpendSeal
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Optional local-only convenience: import Test Mode keys into a selected merchant without retyping them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
DEMO_MODE=false
# Required only by `npm run demo:seed`; the account must already exist.
DEMO_OWNER_USERNAME=

# OrbStack Compose overrides
POSTGRES_PASSWORD=agentrail-local-only
ORBSTACK_PORT=43118
DOCKER_PUBLIC_BASE_URL=http://localhost:43118
DOCKER_WEBAUTHN_ORIGIN=http://localhost:43118
DOCKER_WEBAUTHN_RP_ID=localhost
