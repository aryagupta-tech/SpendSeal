PORT=43117
HOST=127.0.0.1
# For `npm run dev`, browser routes are served by Vite and API/MCP calls proxy to port 43117.
PUBLIC_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql://agentrail:agentrail-local-only@127.0.0.1:5432/agentrail
# Generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
CREDENTIAL_ENCRYPTION_KEY_VERSION=1
OAUTH_ISSUER=http://localhost:5173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_RP_NAME=SpendSeal
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Local extension OAuth client. Keep this exact value unless you rebuild the extension.
EXTENSION_OAUTH_CLIENT_ID=spendseal-browser-extension
BROWSER_AGENT_ENABLED=true
# Safety default: the browser agent may prepare checkout but cannot submit an order.
BROWSER_LIVE_PURCHASE_ENABLED=false
# Comma-separated SpendSeal buyer UUIDs allowed to receive live mode.
# Keep empty until controlled prepare-only tests pass.
BROWSER_LIVE_BUYER_IDS=
# Optional local-only convenience: import Test Mode keys into a selected merchant without retyping them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
DEMO_MODE=false
# Required only by `npm run demo:seed`; the account must already exist.
DEMO_OWNER_USERNAME=

# OrbStack Compose overrides
POSTGRES_PASSWORD=agentrail-local-only
ORBSTACK_PORT=43118
DOCKER_PUBLIC_BASE_URL=http://localhost:43118
DOCKER_WEBAUTHN_ORIGIN=http://localhost:43118
DOCKER_WEBAUTHN_RP_ID=localhost

# Vercel production notes (do not copy these placeholders as-is):
# - Use an external pooled PostgreSQL URL for DATABASE_URL, such as Neon.
# - Use only the permanent Production domain, never a changing Preview URL.
# - Set PUBLIC_BASE_URL, OAUTH_ISSUER, and WEBAUTHN_ORIGIN to the exact same
#   value, for example https://spendseal.vercel.app (without a trailing slash).
# - Set WEBAUTHN_RP_ID to only the hostname, for example spendseal.vercel.app.
