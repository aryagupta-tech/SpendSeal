{
  "name": "@agentrail/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dist/index.js",
    "build": "tsup src/index.ts src/migrate.ts src/seed.ts --format esm --platform node --sourcemap --external pg-native",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentrail/core": "*",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@simplewebauthn/server": "^13.3.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.4",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
